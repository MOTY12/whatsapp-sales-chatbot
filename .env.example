# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_me
DATABASE_NAME=kleva_db
DATABASE_LOGGING=false

# Local PostgreSQL can use DATABASE_SSL=false. In production, enable TLS
# and supply the trusted PostgreSQL CA bundle in PEM format.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=

# Redis / BullMQ (worker only)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
# Defaults to kleva-<NODE_ENV>. Set a distinct prefix for each deployment.
JOBS_QUEUE_PREFIX=
JOBS_CONCURRENCY=4

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_me
META_APP_ID=replace_me
META_APP_SECRET=replace_me
META_REDIRECT_URI=https://your-public-url/meta/embedded-signup/callback
WHATSAPP_BUSINESS_CONFIG_ID=replace_me
WHATSAPP_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Development fallback only. Connected businesses use persisted Meta credentials.
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me

# OpenAI (intent parsing is not implemented in Milestone 0)
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini

# Internal JWT settings (no public dashboard in this MVP)
JWT_SECRET=replace_me
JWT_EXPIRATION=7d

# Optional merchant OIDC. Leave all fields blank to disable merchant routes.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
MERCHANT_DATABASE_USER=
MERCHANT_DATABASE_PASSWORD=
IDENTITY_DATABASE_USER=
IDENTITY_DATABASE_PASSWORD=
