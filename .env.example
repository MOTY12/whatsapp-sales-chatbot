# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_me
DATABASE_NAME=kleva_db
DATABASE_LOGGING=false

# Local PostgreSQL can use DATABASE_SSL=false. In production, enable TLS
# and supply the trusted PostgreSQL CA bundle in PEM format.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=

# Redis / BullMQ (worker only)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
# Defaults to kleva-<NODE_ENV>. Set a distinct prefix for each deployment.
JOBS_QUEUE_PREFIX=
JOBS_CONCURRENCY=4

# Per-tenant monthly usage defaults. Tenant overrides are internal-only.
USAGE_DEFAULT_MONTHLY_WHATSAPP_MESSAGES=1000
USAGE_DEFAULT_MONTHLY_AI_INPUT_TOKENS=100000
USAGE_DEFAULT_MONTHLY_AI_OUTPUT_TOKENS=50000
USAGE_DEFAULT_AI_TOKENS_PER_REQUEST=4096

# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_me
META_APP_ID=replace_me
META_APP_SECRET=replace_me
META_REDIRECT_URI=https://your-public-url/meta/embedded-signup/callback
WHATSAPP_BUSINESS_CONFIG_ID=replace_me
WHATSAPP_API_VERSION=v27.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# Development fallback only. Connected businesses use persisted Meta credentials.
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me

# OpenAI key is used by the authenticated merchant playground. Live WhatsApp
# replies remain disabled unless AI_RESPONSES_ENABLED is explicitly enabled.
AI_RESPONSES_ENABLED=false
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=12000
AI_HANDOFF_MESSAGE="I don't have enough information to confirm that. Let me connect you with someone from the business."

# Internal JWT settings (no public dashboard in this MVP)
JWT_SECRET=replace_me
JWT_EXPIRATION=7d

# Optional merchant OIDC. Leave all fields blank to disable merchant routes.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Exact browser-facing dashboard origin; drives CSRF origin checks and secure cookie mode.
DASHBOARD_PUBLIC_ORIGIN=http://localhost:3001
# Optional additional exact origins for local + tunnel development (comma-separated).
# Never use wildcards. Set the same list in the dashboard and backend environments.
DASHBOARD_ALLOWED_ORIGINS=
MERCHANT_DATABASE_USER=
MERCHANT_DATABASE_PASSWORD=
IDENTITY_DATABASE_USER=
IDENTITY_DATABASE_PASSWORD=
# Operator-only approval CLI; provision an individual least-privilege database role.
PILOT_OPERATOR_DATABASE_USER=
PILOT_OPERATOR_DATABASE_PASSWORD=

# Optional merchant email/password authentication via Mailjet.
EMAIL_AUTH_ENABLED=false
EMAIL_PROVIDER=mailjet
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=Kleva
FRONTEND_URL=http://localhost:3001
# Generate a unique 32-byte key per environment and keep it stable for pending jobs.
EMAIL_PAYLOAD_ENCRYPTION_KEY=
AUTH_RATE_LIMIT_SECRET=replace_me

# Supervised WhatsApp credentials. JSON maps key IDs to 32-byte base64url keys.
WHATSAPP_CREDENTIAL_KEY_ID=
WHATSAPP_CREDENTIAL_KEYS=
