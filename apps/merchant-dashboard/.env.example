# Backend origin used only by the Next.js server. Do not expose with NEXT_PUBLIC_.
KLEVA_BACKEND_ORIGIN=http://localhost:3000
# Exact public origin serving this dashboard, used for same-origin CSRF proof.
DASHBOARD_PUBLIC_ORIGIN=http://localhost:3001
# Optional additional exact browser origins, comma-separated. Avoid wildcards.
DASHBOARD_ALLOWED_ORIGINS=
