PUBLIC_DOMAIN=kleva.example.com
WEBSITE_WIDGET_PUBLIC_ORIGIN=https://kleva.example.com
WEBSITE_SESSION_CLEANUP_ENABLED=false
WEBSITE_SESSION_CLEANUP_DRY_RUN=true
WEBSITE_SESSION_CLEANUP_BATCH=250
WEBSITE_SESSION_CLEANUP_GRACE_HOURS=24
WEBSITE_MESSAGE_RETENTION_DAYS=0
KLEVA_RELEASE_TAG=local
KLEVA_API_ENV_FILE=/etc/kleva/runtime.env
KLEVA_WORKER_ENV_FILE=/etc/kleva/runtime.env
REDIS_PASSWORD=replace-with-a-random-32-byte-or-longer-secret
REDIS_MAXMEMORY=256mb
